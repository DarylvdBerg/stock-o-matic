# Copy this file to .env.prod (or .env) and fill in real values.
# Docker Compose reads the file named `.env` by default; use
# `docker compose --env-file .env.prod ...` if you keep it separate.

# --- PostgreSQL ---
POSTGRES_USER=stockomatic
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=stockomatic

# --- Cloudflare Tunnel ---
# Get this token from Cloudflare Zero Trust dashboard:
#   Networks -> Tunnels -> Create a tunnel -> Cloudflared -> "Install and run"
TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here

# --- Optional ---
LOG_LEVEL=info
